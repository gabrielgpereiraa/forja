# Supabase (Project Settings → API Keys). A chave "publishable" é pública por
# design: a segurança vem do Row Level Security nas tabelas.
# Sem estas variáveis o app roda em modo local (dados só no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nota diária v2 (variáveis de build — mudar exige nova publicação).
# Sem VITE_SCORING_V2_FROM a v2 fica desligada (tudo em v1). Com Supabase
# configurado, a v2 só liga em build de produção da Vercel (trava de prévia).
# VITE_SCORING_V2_FROM=2026-11-10
# VITE_SCORING_V2_UNTIL=

# Homologação: força o modo local (sem Supabase) mesmo com as variáveis acima.
# VITE_DATA_MODE=local
